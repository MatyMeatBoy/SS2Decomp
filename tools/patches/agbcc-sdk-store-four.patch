+/* Do not cross opaque assembly or control flow when proving that the ADD's
+   condition codes are dead. The target epilogue is an ABI return, whose NZCV
+   are not C return values. An explicit new CC0 value also kills the old one.
+   A naked C body must supply an ABI-only external tail: arbitrary global ASM
+   consuming physical flags is outside this C-return contract. */
+static int
+thumb_store_four_flags_dead(rtx last)
+{
+    rtx scan = next_nonnote_insn(last);
+    for (; scan; scan = next_nonnote_insn(scan))
+    {
+        rtx pattern;
+        if (GET_CODE(scan) == CODE_LABEL || GET_CODE(scan) == BARRIER)
+            return 0;
+        if (GET_CODE(scan) != INSN && GET_CODE(scan) != JUMP_INSN)
+            return 0;
+        pattern = PATTERN(scan);
+        if (GET_CODE(scan) == JUMP_INSN
+            && GET_CODE(pattern) == UNSPEC_VOLATILE && XINT(pattern, 1) == 1
+            && XVECLEN(pattern, 0) == 1
+            && GET_CODE(XVECEXP(pattern, 0, 0)) == CONST_INT
+            && INTVAL(XVECEXP(pattern, 0, 0)) == 0)
+            return 1;
+        if (GET_CODE(pattern) == RETURN) return 1;
+        if (GET_CODE(pattern) == ASM_INPUT || asm_noperands(pattern) >= 0)
+            return 0;
+        if (reg_referenced_p(cc0_rtx, pattern)) return 0;
+        if (sets_cc0_p(pattern)) return 1;
+        if (GET_CODE(scan) == JUMP_INSN) return 0;
+    }
+    return 0;
+}
+
+int
+thumb_store_four_p(rtx *operands, rtx last)
+{
+    int i, previous = -1;
+    rtx scan = last;
+    rtx base = operands[8];
+    /* genpeep may skip standalone USE/CLOBBER instructions. This rule must
+       consume exactly its five SETs, with notes as the only intervening RTL. */
+    for (i = 4; i >= 0; i--)
+    {
+        rtx set;
+        if (!scan || GET_CODE(scan) != INSN
+            || GET_CODE(PATTERN(scan)) != SET) return 0;
+        set = PATTERN(scan);
+        if (i == 4)
+        {
+            if (!rtx_equal_p(SET_DEST(set), base)) return 0;
+        }
+        else if (!rtx_equal_p(SET_DEST(set), operands[2*i])
+                 || !rtx_equal_p(SET_SRC(set), operands[2*i+1]))
+            return 0;
+        if (i) scan = prev_nonnote_insn(scan);
+    }
+    if (!flag_thumb_store_four || GET_CODE(base) != REG || REGNO(base) >= 8)
+        return 0;
+    for (i = 0; i < 4; i++)
+    {
+        rtx mem = operands[2*i], value = operands[2*i+1], address;
+        if (GET_CODE(mem) != MEM || GET_MODE(mem) != SImode
+            || MEM_VOLATILE_P(mem) || MEM_UNALIGNED_P(mem)
+            || !MEM_THUMB_WORD_ALIGNED_P(mem)
+            || MEM_ALIAS_SET(mem) != MEM_ALIAS_SET(operands[0])
+            || GET_CODE(value) != REG || REGNO(value) >= 8
+            || REGNO(value) <= previous || REGNO(value) == REGNO(base))
+            return 0;
+        address = XEXP(mem, 0);
+        if (i == 0)
+        {
+            if (!rtx_equal_p(address, base)) return 0;
+        }
+        else if (GET_CODE(address) != PLUS
+                 || !rtx_equal_p(XEXP(address, 0), base)
+                 || GET_CODE(XEXP(address, 1)) != CONST_INT
+                 || INTVAL(XEXP(address, 1)) != 4*i)
+            return 0;
+        previous = REGNO(value);
+    }
+    return thumb_store_four_flags_dead(last);
+}
