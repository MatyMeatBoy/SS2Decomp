+/* A deliberately narrow proof for the opt-in Thumb store grouping pass.
+   Do not infer alignment from SImode, register number or arbitrary casts. */
+static int
+thumb_proven_word_pointer(tree exp)
+{
+    tree type = TREE_TYPE(exp);
+    if (TREE_CODE(type) != POINTER_TYPE || TYPE_ALIGN(TREE_TYPE(type)) < 32)
+        return 0;
+    switch (TREE_CODE(exp))
+    {
+    case VAR_DECL:
+    case PARM_DECL:
+        return 1;
+    case NOP_EXPR:
+    case CONVERT_EXPR:
+    case NON_LVALUE_EXPR:
+        return thumb_proven_word_pointer(TREE_OPERAND(exp, 0));
+    case PLUS_EXPR:
+        return TREE_CODE(TREE_OPERAND(exp, 1)) == INTEGER_CST
+            && (TREE_INT_CST_LOW(TREE_OPERAND(exp, 1)) & 3) == 0
+            && thumb_proven_word_pointer(TREE_OPERAND(exp, 0));
+    case ADDR_EXPR:
+        exp = TREE_OPERAND(exp, 0);
+        return TREE_CODE(exp) == VAR_DECL && DECL_ALIGN(exp) >= 32;
+    default:
+        return 0;
+    }
+}
