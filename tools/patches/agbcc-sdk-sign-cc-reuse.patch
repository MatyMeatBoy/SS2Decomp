+/* Prove a single result-sign consumer and no subsequent old C/V users. */
+static int
+thumb_sign_cc_consumer(rtx insn, rtx value)
+{
+    rtx scan = next_nonnote_insn(insn), p, source, condition, yes, no;
+    int stores = 8, budget = 256;
+    while (scan && stores-- && thumb_cc_reuse_store(scan))
+        scan = next_nonnote_insn(scan);
+    if (!scan || GET_CODE(scan) != INSN) return 0;
+    p = PATTERN(scan);
+    if (GET_CODE(p) != SET || SET_DEST(p) != cc0_rtx
+        || !rtx_equal_p(SET_SRC(p), value)) return 0;
+    scan = next_nonnote_insn(scan);
+    if (!scan || GET_CODE(scan) != JUMP_INSN) return 0;
+    p = PATTERN(scan);
+    if (GET_CODE(p) != SET || SET_DEST(p) != pc_rtx) return 0;
+    source = SET_SRC(p);
+    if (GET_CODE(source) != IF_THEN_ELSE) return 0;
+    condition = XEXP(source, 0);
+    if ((GET_CODE(condition) != GE && GET_CODE(condition) != LT)
+        || XEXP(condition, 0) != cc0_rtx || XEXP(condition, 1) != const0_rtx) return 0;
+    yes = XEXP(source, 1); no = XEXP(source, 2);
+    if (GET_CODE(yes) == LABEL_REF && no == pc_rtx)
+        return thumb_cc_reuse_flags_dead(XEXP(yes, 0), &budget)
+            && thumb_cc_reuse_flags_dead(next_nonnote_insn(scan), &budget);
+    if (yes == pc_rtx && GET_CODE(no) == LABEL_REF)
+        return thumb_cc_reuse_flags_dead(next_nonnote_insn(scan), &budget)
+            && thumb_cc_reuse_flags_dead(XEXP(no, 0), &budget);
+    return 0;
+}
