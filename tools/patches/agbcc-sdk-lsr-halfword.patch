+
+;; Opt-in LSR flags are equivalent to compare-with-zero only for EQ/NE.
+;; Immediate zero is excluded: Thumb LSR #0 encodes a shift of 32.
+(define_insn "*lsr_flags_dead"
+  [(set (cc0)
+        (lshiftrt:SI (match_operand:SI 1 "s_register_operand" "l")
+                     (match_operand:SI 2 "const_int_operand" "N")))
+   (clobber (match_scratch:SI 0 "=l"))]
+  "flag_lsr_flags && INTVAL (operands[2]) > 0
+   && next_insn_tests_no_inequality (insn)"
+  "lsr\\t%0, %1, %2")
+
+(define_insn "*lsr_flags_live"
+  [(set (cc0)
+        (lshiftrt:SI (match_operand:SI 1 "s_register_operand" "l")
+                     (match_operand:SI 2 "const_int_operand" "N")))
+   (set (match_operand:SI 0 "s_register_operand" "=l")
+        (lshiftrt:SI (match_dup 1) (match_dup 2)))]
+  "flag_lsr_flags && INTVAL (operands[2]) > 0
+   && next_insn_tests_no_inequality (insn)"
+  "lsr\\t%0, %1, %2")
+
