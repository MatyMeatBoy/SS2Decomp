+/* Prefer a later existing dead-code boundary only while code plus a
+   conservative reservation for every literal remains in reach. Duplicate
+   constants are intentionally overcounted; HI loads become SI in reorg. */
+static rtx
+thumb_find_late_pool_barrier(rtx scan)
+{
+    rtx best = 0;
+    int code_bytes = 0, pool_bytes = 0, budget = 4096;
+    for (; scan && budget-- > 0; scan = NEXT_INSN(scan)) {
+        int length = get_attr_length(scan);
+        if (GET_CODE(scan) == INSN && GET_CODE(PATTERN(scan)) == SET) {
+            rtx p = PATTERN(scan), source = SET_SRC(p), dest = SET_DEST(p);
+            enum machine_mode mode = GET_MODE(dest);
+            if (dest != pc_rtx && fixit(source, mode)) {
+                int size = GET_MODE_SIZE(mode);
+                if (size < 4) size = 4;
+                if (size != 4 && size != 8) break;
+                pool_bytes += size;
+                if (length < size / 2) length = size / 2;
+            }
+        }
+        code_bytes += length;
+        /* Preserve margin for word alignment and Thumb's PC bias. */
+        if (code_bytes + pool_bytes > MAX_COUNT_SI) break;
+        if (GET_CODE(scan) == BARRIER) best = scan;
+    }
+    return best;
+}
