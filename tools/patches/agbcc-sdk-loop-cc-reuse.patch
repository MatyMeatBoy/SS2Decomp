+/* Known direct CFG edges only. Return epilogues have no local successor. */
+static int
+thumb_loop_cc_return(rtx p)
+{
+    return GET_CODE(p) == RETURN
+        || (GET_CODE(p) == UNSPEC_VOLATILE && XINT(p, 1) == 1
+            && XVECLEN(p, 0) == 1
+            && GET_CODE(XVECEXP(p, 0, 0)) == CONST_INT
+            && INTVAL(XVECEXP(p, 0, 0)) == 0);
+}
+
+static rtx
+thumb_loop_cc_target(rtx jump)
+{
+    rtx p = PATTERN(jump), source, yes, no;
+    if (GET_CODE(p) != SET || SET_DEST(p) != pc_rtx) return 0;
+    source = SET_SRC(p);
+    if (GET_CODE(source) == LABEL_REF) return XEXP(source, 0);
+    if (GET_CODE(source) != IF_THEN_ELSE) return 0;
+    yes = XEXP(source, 1); no = XEXP(source, 2);
+    if (GET_CODE(yes) == LABEL_REF && no == pc_rtx) return XEXP(yes, 0);
+    if (yes == pc_rtx && GET_CODE(no) == LABEL_REF) return XEXP(no, 0);
+    return 0;
+}
+
+/* A unique entry seeds 0..255. Only SUB #1 changes the counter, and
+   the sole repeat edge requires its signed result >0. Inductively every
+   SUB input is 0..255, hence result -1..254 and V=0. This is not valid
+   for an arbitrary SI decrement at INT_MIN. */
+static int
+thumb_loop_cc_range(rtx sub, rtx latch, rtx header, rtx value)
+{
+    rtx scan, p, source, labels[256], target;
+    int count = 0, budget = 256, i, inside = 0, found_sub = 0, found_latch = 0;
+    if (GET_CODE(header) != CODE_LABEL || LABEL_NUSES(header) != 1
+        || JUMP_LABEL(latch) != header) return 0;
+    for (scan = header; scan && budget-- > 0; scan = NEXT_INSN(scan)) {
+        if (GET_CODE(scan) == CODE_LABEL) labels[count++] = scan;
+        else if (GET_CODE(scan) == NOTE || GET_CODE(scan) == BARRIER) ;
+        else {
+            if (GET_RTX_CLASS(GET_CODE(scan)) != 'i'
+                || GET_CODE(scan) == CALL_INSN) return 0;
+            p = PATTERN(scan);
+            if (GET_CODE(p) == ASM_INPUT || asm_noperands(p) >= 0) return 0;
+            if (scan == sub) found_sub = 1;
+            else if (reg_set_p(value, scan)) return 0;
+            if (GET_CODE(scan) == JUMP_INSN
+                && !thumb_loop_cc_return(p) && !thumb_loop_cc_target(scan)) return 0;
+        }
+        if (scan == latch) { found_latch = 1; break; }
+    }
+    if (!found_sub || !found_latch) return 0;
+    /* The only outside entry is fallthrough through the seed. */
+    budget = 4096;
+    for (scan = get_insns(); scan && budget-- > 0; scan = NEXT_INSN(scan)) {
+        if (scan == header) inside = 1;
+        if (GET_CODE(scan) == JUMP_INSN && !thumb_loop_cc_return(PATTERN(scan))) {
+            target = thumb_loop_cc_target(scan);
+            if (!target) return 0;
+            if (!inside) for (i = 0; i < count; ++i)
+                if (target == labels[i]) return 0;
+        }
+        if (scan == latch) inside = 0;
+    }
+    if (scan) return 0;
+    budget = 8;
+    for (scan = prev_nonnote_insn(header); scan && budget-- > 0;
+         scan = prev_nonnote_insn(scan)) {
+        if (GET_CODE(scan) != INSN) return 0;
+        p = PATTERN(scan);
+        if (GET_CODE(p) != SET || asm_noperands(p) >= 0) return 0;
+        if (reg_set_p(value, scan)) {
+            if (!rtx_equal_p(SET_DEST(p), value)) return 0;
+            source = SET_SRC(p);
+            return GET_CODE(source) == ZERO_EXTEND && GET_MODE(source) == SImode
+                && GET_CODE(XEXP(source, 0)) == MEM
+                && GET_MODE(XEXP(source, 0)) == QImode
+                && !side_effects_p(XEXP(source, 0));
+        }
+        if (side_effects_p(SET_DEST(p)) || side_effects_p(SET_SRC(p))) return 0;
+    }
+    return 0;
+}
+
+static int
+thumb_loop_cc_consumer(rtx sub, rtx value)
+{
+    rtx compare = next_nonnote_insn(sub), latch, p, source, condition, yes, no, header;
+    int budget = 256;
+    if (!compare || GET_CODE(compare) != INSN) return 0;
+    p = PATTERN(compare);
+    if (GET_CODE(p) != SET || SET_DEST(p) != cc0_rtx
+        || !rtx_equal_p(SET_SRC(p), value)) return 0;
+    latch = next_nonnote_insn(compare);
+    if (!latch || GET_CODE(latch) != JUMP_INSN) return 0;
+    p = PATTERN(latch);
+    if (GET_CODE(p) != SET || SET_DEST(p) != pc_rtx) return 0;
+    source = SET_SRC(p);
+    if (GET_CODE(source) != IF_THEN_ELSE) return 0;
+    condition = XEXP(source, 0); yes = XEXP(source, 1); no = XEXP(source, 2);
+    if (GET_CODE(condition) != GT || XEXP(condition, 0) != cc0_rtx
+        || XEXP(condition, 1) != const0_rtx
+        || GET_CODE(yes) != LABEL_REF || no != pc_rtx) return 0;
+    header = XEXP(yes, 0);
+    return thumb_loop_cc_range(sub, latch, header, value)
+        && thumb_cc_reuse_flags_dead(header, &budget)
+        && thumb_cc_reuse_flags_dead(next_nonnote_insn(latch), &budget);
+}
