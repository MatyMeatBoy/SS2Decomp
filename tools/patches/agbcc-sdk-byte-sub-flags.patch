--- a/gcc/thumb.c
+++ b/gcc/thumb.c
@@ -351,0 +352,110 @@
+
+/* A QI zero-extension immediately before SUB #1 proves an input in 0..255.
+   SUB's N/Z/V then equal CMP(result,0) for signed GT/LE; its carry does not.
+   Only the single signed consumer below may observe these flags. */
+static int
+thumb_byte_flags_dead(rtx scan, rtx join)
+{
+    int limit = 256;
+    for (; scan && limit--; scan = next_nonnote_insn(scan))
+    {
+        rtx p;
+        if (GET_CODE(scan) == CODE_LABEL)
+        {
+            if (scan != join) return 0;
+            continue;
+        }
+        if (GET_CODE(scan) != INSN && GET_CODE(scan) != JUMP_INSN) return 0;
+        p = PATTERN(scan);
+        if (GET_CODE(p) == RETURN) return 1;
+        /* Naked C requires an ABI-only external return, as for other SDK
+           naked bodies. Arbitrary global ASM flag consumers are not C ABI. */
+        if (GET_CODE(scan) == JUMP_INSN && GET_CODE(p) == UNSPEC_VOLATILE
+            && XINT(p,1) == 1 && XVECLEN(p,0) == 1
+            && GET_CODE(XVECEXP(p,0,0)) == CONST_INT
+            && INTVAL(XVECEXP(p,0,0)) == 0) return 1;
+        if (GET_CODE(p) == ASM_INPUT || asm_noperands(p) >= 0) return 0;
+        if (reg_referenced_p(cc0_rtx,p)) return 0;
+        /* Only an explicit full CMP kills all old flags. Do not assume
+           that an arbitrary shift/logical CC0 producer overwrites C/V. */
+        if (GET_CODE(p) == SET && SET_DEST(p) == cc0_rtx
+            && (GET_CODE(SET_SRC(p)) == REG
+                || GET_CODE(SET_SRC(p)) == COMPARE)) return 1;
+        if (GET_CODE(scan) == JUMP_INSN) return 0;
+    }
+    return 0;
+}
+
+static int
+thumb_byte_compare_redundant(rtx compare)
+{
+    rtx p, value, sub, load, branch, condition, target, scan;
+    int limit;
+    if (GET_CODE(compare) != INSN) return 0;
+    p = PATTERN(compare);
+    if (GET_CODE(p) != SET || SET_DEST(p) != cc0_rtx) return 0;
+    value = SET_SRC(p);
+    if (GET_CODE(value) != REG || GET_MODE(value) != SImode
+        || REGNO(value) >= 8) return 0;
+    sub = prev_nonnote_insn(compare);
+    if (!sub || GET_CODE(sub) != INSN) return 0;
+    p = PATTERN(sub);
+    /* The sole optional intervening operation is the preserved STRB of
+       this same low register. No USE/CLOBBER, call or opaque ASM is skipped. */
+    if (GET_CODE(p) == SET && GET_CODE(SET_DEST(p)) == MEM
+        && GET_MODE(SET_DEST(p)) == QImode
+        && GET_CODE(SET_SRC(p)) == REG && GET_MODE(SET_SRC(p)) == QImode
+        && REGNO(SET_SRC(p)) == REGNO(value))
+    {
+        if (side_effects_p(SET_DEST(p))) return 0;
+        sub = prev_nonnote_insn(sub);
+        if (!sub || GET_CODE(sub) != INSN) return 0;
+        p = PATTERN(sub);
+    }
+    if (GET_CODE(p) != SET || !rtx_equal_p(SET_DEST(p),value)
+        || GET_CODE(SET_SRC(p)) != PLUS
+        || !rtx_equal_p(XEXP(SET_SRC(p),0),value)
+        || GET_CODE(XEXP(SET_SRC(p),1)) != CONST_INT
+        || INTVAL(XEXP(SET_SRC(p),1)) != -1) return 0;
+    load = prev_nonnote_insn(sub);
+    if (!load || GET_CODE(load) != INSN) return 0;
+    p = PATTERN(load);
+    if (GET_CODE(p) != SET || !rtx_equal_p(SET_DEST(p),value)
+        || GET_CODE(SET_SRC(p)) != ZERO_EXTEND
+        || GET_MODE(SET_SRC(p)) != SImode
+        || GET_CODE(XEXP(SET_SRC(p),0)) != MEM
+        || GET_MODE(XEXP(SET_SRC(p),0)) != QImode) return 0;
+    branch = next_nonnote_insn(compare);
+    if (!branch || GET_CODE(branch) != JUMP_INSN) return 0;
+    p = PATTERN(branch);
+    if (GET_CODE(p) != SET || SET_DEST(p) != pc_rtx
+        || GET_CODE(SET_SRC(p)) != IF_THEN_ELSE) return 0;
+    p = SET_SRC(p);
+    condition = XEXP(p,0);
+    if ((GET_CODE(condition) != GT && GET_CODE(condition) != LE)
+        || XEXP(condition,0) != cc0_rtx
+        || GET_CODE(XEXP(condition,1)) != CONST_INT
+        || INTVAL(XEXP(condition,1)) != 0
+        || GET_CODE(XEXP(p,1)) != LABEL_REF || XEXP(p,2) != pc_rtx) return 0;
+    target = XEXP(XEXP(p,1),0);
+    /* Restrict to a forward acyclic diamond; never infer a loop range. */
+    limit = 256;
+    for (scan = next_nonnote_insn(branch); scan && scan != target && limit--;
+         scan = next_nonnote_insn(scan)) {}
+    if (scan != target) return 0;
+    return thumb_byte_flags_dead(next_nonnote_insn(branch),target)
+        && thumb_byte_flags_dead(next_nonnote_insn(target),target);
+}
+
+static void
+thumb_byte_sub_flags(rtx first)
+{
+    rtx insn, next;
+    if (!flag_thumb_byte_sub_flags) return;
+    for (insn = first; insn; insn = next)
+    {
+        next = NEXT_INSN(insn);
+        if (thumb_byte_compare_redundant(insn)) delete_insn(insn);
+    }
+}
+
@@ -355,0 +466 @@
