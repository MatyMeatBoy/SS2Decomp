+/* Replay only a genuine full low-register CMP at a unique forward taken
+   edge. Never promote implicit zero-test facts whose C/V may be stale. */
+void
+thumb_sdk_label_cc(rtx label)
+{
+    rtx jump, barrier, prev, p, source, left, right, condition, yes, no, scan;
+    int budget = 256;
+    if (!flag_thumb_cc_reuse || !flag_thumb_label_cc_reuse
+        || !optimize || LABEL_NUSES(label) != 1) return;
+    barrier = prev_nonnote_insn(label);
+    jump = LABEL_REFS(label);
+    if (!barrier || GET_CODE(barrier) != BARRIER
+        || !jump || GET_CODE(jump) != JUMP_INSN) return;
+    p = PATTERN(jump);
+    if (GET_CODE(p) != SET || SET_DEST(p) != pc_rtx) return;
+    source = SET_SRC(p);
+    if (GET_CODE(source) != IF_THEN_ELSE) return;
+    condition = XEXP(source, 0);
+    if (GET_RTX_CLASS(GET_CODE(condition)) != '<'
+        || XEXP(condition, 0) != cc0_rtx
+        || XEXP(condition, 1) != const0_rtx) return;
+    yes = XEXP(source, 1); no = XEXP(source, 2);
+    if (!((GET_CODE(yes) == LABEL_REF && XEXP(yes, 0) == label && no == pc_rtx)
+        || (yes == pc_rtx && GET_CODE(no) == LABEL_REF && XEXP(no, 0) == label))) return;
+    for (scan = NEXT_INSN(jump); scan && scan != label && budget-- > 0;
+         scan = NEXT_INSN(scan)) ;
+    if (scan != label) return;
+    prev = prev_nonnote_insn(jump);
+    if (!prev || GET_CODE(prev) != INSN) return;
+    p = PATTERN(prev);
+    if (GET_CODE(p) != SET || SET_DEST(p) != cc0_rtx) return;
+    source = SET_SRC(p);
+    if (GET_CODE(source) != COMPARE) return;
+    left = XEXP(source, 0); right = XEXP(source, 1);
+    if (GET_CODE(left) != REG || GET_MODE(left) != SImode
+        || REGNO(left) >= 8) return;
+    if (!(GET_CODE(right) == REG && GET_MODE(right) == SImode && REGNO(right) < 8)
+        && !(GET_CODE(right) == CONST_INT && INTVAL(right) >= 0 && INTVAL(right) <= 255)) return;
+    thumb_sdk_notice_update_cc(p, prev);
+    thumb_sdk_notice_update_cc(PATTERN(jump), jump);
+}
